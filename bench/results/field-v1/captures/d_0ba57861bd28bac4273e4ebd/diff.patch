--- a/tests/test_adapters.py
+++ b/tests/test_adapters.py
@@ -155,3 +155,28 @@ async def test_detect_backends_none_running():
         result = await detect_backends()
 
     assert result == []
+
+
+@pytest.mark.asyncio
+async def test_detect_backends_reports_the_required_adapter_type():
+    ollama_response = MagicMock()
+    ollama_response.raise_for_status = MagicMock()
+    ollama_response.json.return_value = {"models": [{"name": "llama3:8b"}]}
+
+    openai_response = MagicMock()
+    openai_response.raise_for_status = MagicMock()
+    openai_response.json.return_value = {"data": [{"id": "mistral-7b"}]}
+
+    with patch("httpx.AsyncClient") as mock_client_cls:
+        mock_client = AsyncMock()
+        mock_client.get = AsyncMock(side_effect=[ollama_response, openai_response])
+        mock_client.__aenter__ = AsyncMock(return_value=mock_client)
+        mock_client.__aexit__ = AsyncMock(return_value=False)
+        mock_client_cls.return_value = mock_client
+
+        result = await detect_backends()
+
+    assert [(backend.name, backend.backend_type) for backend in result] == [
+        ("ollama", "ollama"),
+        ("llama.cpp", "openai_compat"),
+    ]
